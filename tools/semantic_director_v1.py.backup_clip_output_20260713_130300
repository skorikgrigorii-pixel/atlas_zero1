def normalized_path(value: str) -> str:
    return str(Path(value).resolve())


def shot_prompt(shot: dict[str, Any]) -> str:
    visual_need = str(shot.get("visual_need") or "").strip()
    story_goal = str(shot.get("story_goal") or "").strip()
    emotion = str(shot.get("emotion") or "").strip()
    block = str(shot.get("block") or "").strip()

    return (
        "Historical documentary film shot about the Franklin expedition. "
        f"Visual requirement: {visual_need}. "
        f"Narrative meaning: {story_goal}. "
        f"Emotion and atmosphere: {emotion}. "
        f"Story block: {block}. "
        "Period accurate, cinematic, realistic, Arctic documentary visual."
    )


def load_image(path: Path) -> Image.Image:
    with Image.open(path) as source:
        image = ImageOps.exif_transpose(source)
        return image.convert("RGB")


def encode_images(
    model: CLIPModel,
    processor: CLIPProcessor,
    assets: list[dict[str, Any]],
) -> torch.Tensor:
    embeddings: list[torch.Tensor] = []

    for index, asset in enumerate(assets, start=1):
        path = Path(asset["path"])
        image = load_image(path)

        inputs = processor(
            images=image,
            return_tensors="pt",
        )

        with torch.no_grad():
            feature = model.get_image_features(
                **inputs
            )

        feature = feature / feature.norm(
            dim=-1,
            keepdim=True,
        )

        embeddings.append(feature.cpu())

        print(
            f"IMAGE EMBEDDING "
            f"{index:03d}/{len(assets):03d}: "
            f"{path.name}"
        )

    return torch.cat(embeddings, dim=0)


def encode_texts(
    model: CLIPModel,
    processor: CLIPProcessor,
    texts: list[str],
) -> torch.Tensor:
    batches: list[torch.Tensor] = []
    batch_size = 24

    for start in range(0, len(texts), batch_size):
        batch = texts[start:start + batch_size]

        inputs = processor(
            text=batch,
            return_tensors="pt",
            padding=True,
            truncation=True,
        )

        with torch.no_grad():
            features = model.get_text_features(
                **inputs
            )

        features = features / features.norm(
            dim=-1,
            keepdim=True,
        )

        batches.append(features.cpu())

        print(
            f"TEXT EMBEDDING "
            f"{min(start + batch_size, len(texts)):03d}/"
            f"{len(texts):03d}"
        )

    return torch.cat(batches, dim=0)


def group_bonus(
    shot_text: str,
    semantic_class: str,
) -> float:
    text = shot_text.lower()
    bonus = 0.0

    keyword_groups = {
        "final_note": {
            "note", "message", "written", "document",
            "record", "last words", "all well",
        },
        "medical_records": {
            "medical", "health", "disease", "lead",
            "bones", "scurvy", "death",
        },
        "archive_letter": {
            "letter", "admiralty", "correspondence",
            "archive", "written",
        },
        "archive_records": {
            "archive", "records", "documents",
            "researcher", "evidence",
        },
        "archive_map": {
            "map", "route", "navigation", "chart",
            "location", "position",
        },
        "underwater_robot": {
            "robot", "rov", "remote vehicle",
            "modern expedition", "underwater camera",
        },
        "underwater_wreck": {
            "wreck", "underwater", "discovered",
            "seabed", "sunken", "found",
        },
        "sonar_scan": {
            "sonar", "scan", "technology",
            "multibeam", "search equipment",
        },
        "crew_command": {
            "captain", "commander", "franklin",
            "officer", "command",
        },
        "crew_working": {
            "crew", "sailors", "men", "working",
            "deck", "preparation",
        },
        "ship_detail": {
            "hull", "rigging", "deck", "bow",
            "pressure", "damage",
        },
        "arctic_aerial": {
            "arctic", "route", "landscape",
            "vast", "northwest passage", "ice field",
        },
        "ship_in_ice": {
            "ship", "erebus", "terror", "ice",
            "frozen", "trapped", "drift",
        },
    }

    keywords = keyword_groups.get(
        semantic_class,
        set(),
    )

    matches = sum(
        1
        for keyword in keywords
        if keyword in text
    )

    bonus += min(0.22, matches * 0.055)

    return bonus


def allowed_reuse(asset: dict[str, Any]) -> int:
    semantic_class = asset["semantic_class"]

    if semantic_class in SPECIAL_GROUPS:
        return 3

    if semantic_class in {
        "crew_command",
        "crew_working",
        "arctic_aerial",
    }:
        return 4

    if semantic_class in {
        "ship_detail",
        "ship_in_ice",
    }:
        return 6

    return 4


def reuse_penalty(
    current_use: int,
    soft_limit: int,
) -> float:
    if current_use == 0:
        return 0.0

    if current_use < soft_limit:
        return current_use * 0.035

    overflow = current_use - soft_limit + 1

    return (
        soft_limit * 0.035
        + overflow * 0.16
    )


def consecutive_penalty(
    asset_id: str,
    recent_assets: list[str],
) -> float:
    if not recent_assets:
        return 0.0

    penalty = 0.0

    if recent_assets[-1] == asset_id:
        penalty += 0.85

    if asset_id in recent_assets[-3:]:
        penalty += 0.40

    if asset_id in recent_assets[-7:]:
        penalty += 0.16

    return penalty


def group_sequence_penalty(
    semantic_class: str,
    recent_groups: list[str],
) -> float:
    if not recent_groups:
        return 0.0

    same_last_five = sum(
        1
        for group in recent_groups[-5:]
        if group == semantic_class
    )

    return max(
        0.0,
        (same_last_five - 2) * 0.10,
    )


def main() -> None:
    OUTPUT_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not CATALOG_PATH.exists():
        raise FileNotFoundError(
            f"Catalog not found: {CATALOG_PATH}"
        )

    catalog_payload = json.loads(
        CATALOG_PATH.read_text(
            encoding="utf-8"
        )
    )

    assets = [
        dict(item)
        for item in catalog_payload["assets"]
        if int(item.get("max_use") or 0) > 0
        and not item.get("duplicate_of")
        and Path(item["path"]).exists()
    ]

    if not assets:
        raise RuntimeError(
            "No usable visual assets in semantic catalog."
        )

    db = Database()
    db.init()

    shots = [
        dict(row)
        for row in db.rows(
            """
            SELECT
                id,
                idx,
                start_sec,
                end_sec,
                block,
                story_goal,
                visual_need,
                emotion
            FROM shots
            WHERE project_id=?
            ORDER BY idx
            """,
            (PROJECT_ID,),
        )
    ]

    if not shots:
        raise RuntimeError(
            "No shots found in database."
        )

    if TIMELINE_PATH.exists():
        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        backup = (
            TIMELINE_PATH.parent
            / f"timeline_before_semantic_{timestamp}.json"
        )

        shutil.copy2(
            TIMELINE_PATH,
            backup,
        )

        print("TIMELINE BACKUP =", backup)

    model = CLIPModel.from_pretrained(
        MODEL_NAME
    )

    processor = CLIPProcessor.from_pretrained(
        MODEL_NAME
    )

    model.eval()

    print("=" * 72)
    print("ATLAS ZERO — SEMANTIC DIRECTOR V1")
    print("=" * 72)
    print("Shots         :", len(shots))
    print("Usable assets :", len(assets))

    image_embeddings = encode_images(
        model,
        processor,
        assets,
    )

    prompts = [
        shot_prompt(shot)
        for shot in shots
    ]

    text_embeddings = encode_texts(
        model,
        processor,
        prompts,
    )

    similarities = (
        text_embeddings
        @ image_embeddings.T
    )

    usage: Counter[str] = Counter()
    group_usage: Counter[str] = Counter()

    recent_assets: list[str] = []
    recent_groups: list[str] = []

    assignments: list[dict[str, Any]] = []

    db.execute(
        """
        DELETE FROM director_decisions
        WHERE project_id=?
        """,
        (PROJECT_ID,),
    )

    for shot_position, shot in enumerate(
        shots
    ):
        prompt = prompts[shot_position]

        ranked: list[
            tuple[float, int, dict[str, Any], dict[str, float]]
        ] = []

        for asset_position, asset in enumerate(
            assets
        ):
            asset_id = str(asset["asset_id"])
            semantic_class = str(
                asset["semantic_class"]
            )

            clip_score = float(
                similarities[
                    shot_position,
                    asset_position,
                ]
            )

            semantic_bonus = group_bonus(
                prompt,
                semantic_class,
            )

            unused_bonus = (
                0.12
                if usage[asset_id] == 0
                else 0.0
            )

            diversity_bonus = (
                0.045
                / (
                    1
                    + group_usage[
                        semantic_class
                    ]
                )
            )

            repetition_penalty = reuse_penalty(
                usage[asset_id],
                allowed_reuse(asset),
            )

            near_penalty = consecutive_penalty(
                asset_id,
                recent_assets,
            )

            group_penalty = group_sequence_penalty(
                semantic_class,
                recent_groups,
            )

            final_score = (
                clip_score
                + semantic_bonus
                + unused_bonus
                + diversity_bonus
                - repetition_penalty
                - near_penalty
                - group_penalty
            )

            components = {
                "clip_similarity": round(
                    clip_score,
                    5,
                ),
                "semantic_bonus": round(
                    semantic_bonus,
                    5,
                ),
                "unused_bonus": round(
                    unused_bonus,
                    5,
                ),
                "diversity_bonus": round(
                    diversity_bonus,
                    5,
                ),
                "reuse_penalty": round(
                    repetition_penalty,
                    5,
                ),
                "consecutive_penalty": round(
                    near_penalty,
                    5,
                ),
                "group_penalty": round(
                    group_penalty,
                    5,
                ),
            }

            ranked.append(
                (
                    final_score,
                    asset_position,
                    asset,
                    components,
                )
            )

        ranked.sort(
            key=lambda item: item[0],
            reverse=True,
        )

        (
            final_score,
            _,
            selected,
            components,
        ) = ranked[0]

        asset_id = str(
            selected["asset_id"]
        )

        semantic_class = str(
            selected["semantic_class"]
        )

        db.execute(
            """
            UPDATE shots
            SET
                assigned_asset_id=?,
                status='assigned'
            WHERE id=?
            """,
            (
                asset_id,
                shot["id"],
            ),
        )

        alternatives = [
            {
                "asset_id": item[2]["asset_id"],
                "filename": item[2]["filename"],
                "semantic_class": item[2][
                    "semantic_class"
                ],
                "score": round(
                    item[0],
                    5,
                ),
            }
            for item in ranked[1:4]
        ]

        reason = (
            f"Semantic Director selected "
            f"{selected['filename']} "
            f"for visual need "
            f"'{shot.get('visual_need')}'. "
            f"Class={semantic_class}; "
            f"CLIP={components['clip_similarity']}; "
            f"final_score={round(final_score, 5)}; "
            f"previous_uses={usage[asset_id]}."
        )

        db.execute(
            """
            INSERT INTO director_decisions(
                project_id,
                shot_id,
                asset_id,
                score,
                reason,
                alternatives
            )
            VALUES(?,?,?,?,?,?)
            """,
            (
                PROJECT_ID,
                shot["id"],
                asset_id,
                round(final_score, 5),
                reason,
                json.dumps(
                    alternatives,
                    ensure_ascii=False,
                ),
            ),
        )

        usage[asset_id] += 1
        group_usage[semantic_class] += 1

        recent_assets.append(asset_id)
        recent_groups.append(
            semantic_class
        )

        assignment = {
            "shot_id": shot["id"],
            "shot_index": shot["idx"],
            "start_sec": shot["start_sec"],
            "end_sec": shot["end_sec"],
            "block": shot.get("block"),
            "visual_need": shot.get(
                "visual_need"
            ),
            "story_goal": shot.get(
                "story_goal"
            ),
            "emotion": shot.get(
                "emotion"
            ),
            "semantic_prompt": prompt,
            "selected_asset_id": asset_id,
            "selected_filename": selected[
                "filename"
            ],
            "selected_path": selected[
                "path"
            ],
            "semantic_class": semantic_class,
            "score": round(
                final_score,
                5,
            ),
            "score_components": components,
            "usage_after_assignment": (
                usage[asset_id]
            ),
            "alternatives": alternatives,
        }

        assignments.append(
            assignment
        )

        print(
            f"SHOT {shot['idx']:03d} | "
            f"{semantic_class:<19} | "
            f"{selected['filename']} | "
            f"{final_score:.4f}"
        )

    runtime = MovieRuntimeRC1(
        db,
        PROJECT_ID,
    )

    timeline_result = runtime._build_timeline()

    unique_assets = len(usage)

    most_used = []

    asset_by_id = {
        str(asset["asset_id"]): asset
        for asset in assets
    }

    for asset_id, count in usage.most_common():
        asset = asset_by_id[asset_id]

        most_used.append(
            {
                "asset_id": asset_id,
                "filename": asset[
                    "filename"
                ],
                "semantic_class": asset[
                    "semantic_class"
                ],
                "uses": count,
            }
        )

    report = {
        "version": "1.0",
        "project_id": PROJECT_ID,
        "state": "SEMANTICALLY_ASSIGNED",
        "model": MODEL_NAME,
        "shots_total": len(shots),
        "assets_available": len(assets),
        "unique_assets_used": unique_assets,
        "semantic_groups_used": len(
            group_usage
        ),
        "asset_usage": most_used,
        "group_usage": dict(
            group_usage
        ),
        "assignments": assignments,
        "timeline_result": timeline_result,
    }

    REPORT_PATH.write_text(
        json.dumps(
            report,
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )

    summary = {
        "project_id": PROJECT_ID,
        "state": report["state"],
        "shots_total": len(shots),
        "assets_available": len(assets),
        "unique_assets_used": unique_assets,
        "semantic_groups_used": len(
            group_usage
        ),
        "maximum_single_asset_usage": (
            max(usage.values())
            if usage
            else 0
        ),
        "top_asset_usage": most_used[:15],
        "group_usage": dict(
            group_usage
        ),
        "report": str(
            REPORT_PATH
        ),
        "timeline": str(
            TIMELINE_PATH
        ),
    }

    SUMMARY_PATH.write_text(
        json.dumps(
            summary,
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )

    print()
    print("=" * 72)
    print("SEMANTIC DIRECTOR RESULT")
    print("=" * 72)
    print(
        json.dumps(
            summary,
            ensure_ascii=False,
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
